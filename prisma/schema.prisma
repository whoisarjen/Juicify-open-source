generator client {
  provider      = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
}

enum kindOfDiets {
  REGULAR
  KETOGENIC
}

enum activityLevels {
  ZERO
  MINIMAL
  AVERAGE
  HIGH
  EXTREME
}

enum goals {
  MINUS_ONE_AND_HALF
  MINUS_ONE_AND_QUARTER
  MINUS_ONE
  MINUS_THREE_QUARTERS
  MINUS_HALF
  ZERO
  HALF
  THREE_QUARTERS
  ONE
  ONE_AND_QUARTER
  ONE_AND_HALF
}

model Account {
  id                Int      @id @default(autoincrement())
  createdAt         DateTime @default(now())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           Int      @id @default(autoincrement())
  createdAt    DateTime @default(now())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Permission {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
  name        String
  description String?
  users       User[]
}

model User {
  id                  Int              @id @default(autoincrement())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @default(now()) @updatedAt
  username            String           @unique @default(uuid())
  name                String?
  surname             String?
  email               String           @unique
  emailVerified       DateTime?
  image               String?
  locale              String           @default("en") @db.Char(2)
  numberOfMeals       Int              @default(5)
  proteinsDay0        Int              @default(0)
  carbsDay0           Int              @default(0)
  fatsDay0            Int              @default(0)
  proteinsDay1        Int              @default(0)
  carbsDay1           Int              @default(0)
  fatsDay1            Int              @default(0)
  proteinsDay2        Int              @default(0)
  carbsDay2           Int              @default(0)
  fatsDay2            Int              @default(0)
  proteinsDay3        Int              @default(0)
  carbsDay3           Int              @default(0)
  fatsDay3            Int              @default(0)
  proteinsDay4        Int              @default(0)
  carbsDay4           Int              @default(0)
  fatsDay4            Int              @default(0)
  proteinsDay5        Int              @default(0)
  carbsDay5           Int              @default(0)
  fatsDay5            Int              @default(0)
  proteinsDay6        Int              @default(0)
  carbsDay6           Int              @default(0)
  fatsDay6            Int              @default(0)
  fiber               Int              @default(10)
  carbsPercentAsSugar Int              @default(10)
  nextCoach           DateTime         @default(now())
  isCoachAnalyze      Boolean          @default(false)
  height              Int              @default(0)
  birth               DateTime         @default(now())
  description         String           @default("")
  website             String           @default("")
  facebook            String           @default("")
  instagram           String           @default("")
  twitter             String           @default("")
  goal                goals            @default(ZERO)
  kindOfDiet          kindOfDiets      @default(REGULAR)
  searchAllPlans      Boolean          @default(true)
  isSportActive       Boolean          @default(false)
  activityLevel       activityLevels   @default(AVERAGE)
  sex                 Boolean          @default(true)
  isBanned            Boolean          @default(false)
  permissions         Permission[]
  accounts            Account[]
  sessions            Session[]
  Exercise            Exercise[]
  WorkoutPlan         WorkoutPlan[]
  WorkoutResult       WorkoutResult[]
  Product             Product[]
  Consumed            Consumed[]
  Measurement         Measurement[]
  Coach               Coach[]
  BurnedCalories      BurnedCalories[]
  Post                Post[]
  WithingsActivity    WithingsActivity[]
  WithingsWorkout     WithingsWorkout[]
  WithingsSleep       WithingsSleep[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Exercise {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int?
  name       String   @db.VarChar(100)
  nameLength Int
  isDeleted  Boolean  @default(false)

  @@unique([userId, name, isDeleted])
  @@index([userId])
}

model WorkoutPlan {
  id             Int             @id @default(autoincrement())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @default(now()) @updatedAt
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  name           String          @db.VarChar(100)
  description    String?
  burnedCalories Int             @default(0)
  isDeleted      Boolean         @default(false)
  exercises      Json
  WorkoutResult  WorkoutResult[]

  @@unique([id, userId])
  @@index([userId])
}

model WorkoutResult {
  id             Int          @id @default(autoincrement())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  name           String       @db.VarChar(100)
  note           String?
  burnedCalories Int          @default(0)
  exercises      Json
  workoutPlan    WorkoutPlan? @relation(fields: [workoutPlanId], references: [id], onDelete: SetNull)
  workoutPlanId  Int?
  whenAdded      DateTime     @default(now())
  finishedAt     DateTime?

  @@unique([id, userId])
  @@index([userId])
  @@index([workoutPlanId])
}

model Product {
  id               Int        @id @default(autoincrement())
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @default(now()) @updatedAt
  user             User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           Int?
  name             String     @db.VarChar(255)
  nameLength       Int
  proteins         Decimal    @default(0) @db.Decimal(4, 1)
  carbs            Decimal    @default(0) @db.Decimal(4, 1)
  sugar            Decimal    @default(0) @db.Decimal(4, 1)
  fats             Decimal    @default(0) @db.Decimal(4, 1)
  fiber            Decimal    @default(0) @db.Decimal(4, 1)
  sodium           Decimal    @default(0) @db.Decimal(4, 1)
  ethanol          Decimal    @default(0) @db.Decimal(4, 1)
  barcode          String?
  isVerified       Boolean?   @default(false)
  isDeleted        Boolean?   @default(false)
  isExpectingCheck Boolean?   @default(false)
  Consumed         Consumed[]

  @@unique([id, userId])
  @@unique([name, userId])
  @@index([userId])
}

model Consumed {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  whenAdded DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  howMany   Decimal  @default(1) @db.Decimal(4, 1)
  meal      Int      @default(0)

  @@unique([id, userId])
  @@index([userId])
  @@index([productId])
}

model Measurement {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  whenAdded     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weight        Decimal  @default(0) @db.Decimal(4, 1)
  userId        Int
  fatRatio      Decimal? @db.Decimal(4, 1)
  fatMass       Decimal? @db.Decimal(4, 1)
  muscleMass    Decimal? @db.Decimal(4, 1)
  boneMass      Decimal? @db.Decimal(3, 1)
  waterMass     Decimal? @db.Decimal(4, 1)
  fatFreeMass       Decimal? @db.Decimal(4, 1)
  heartPulse        Int?
  diastolicBp       Int?
  systolicBp        Int?
  temperature       Decimal? @db.Decimal(4, 2)
  bodyTemperature   Decimal? @db.Decimal(4, 2)
  skinTemperature   Decimal? @db.Decimal(4, 2)
  spo2              Decimal? @db.Decimal(4, 1)
  pulseWaveVelocity Decimal? @db.Decimal(5, 2)
  vo2Max            Decimal? @db.Decimal(4, 1)
  waist             Decimal? @db.Decimal(4, 1)
  hips              Decimal? @db.Decimal(4, 1)
  source            String?  @db.VarChar(20)

  @@unique([id, userId])
  @@index([userId])
}

model WithingsActivity {
  id               Int      @id @default(autoincrement())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
  date             DateTime
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           Int
  steps            Int      @default(0)
  distance         Decimal  @default(0) @db.Decimal(10, 2)
  activeCalories   Decimal  @default(0) @db.Decimal(8, 2)
  totalCalories    Decimal  @default(0) @db.Decimal(8, 2)
  elevation        Decimal  @default(0) @db.Decimal(8, 2)
  softDuration     Int      @default(0)
  moderateDuration Int      @default(0)
  intenseDuration  Int      @default(0)
  hrAverage        Int?
  hrMin            Int?
  hrMax            Int?
  hrZone0          Int      @default(0)
  hrZone1          Int      @default(0)
  hrZone2          Int      @default(0)
  hrZone3          Int      @default(0)

  @@unique([userId, date])
  @@index([userId])
}

model WithingsWorkout {
  id            Int      @id @default(autoincrement())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  category      Int
  categoryName  String?  @db.VarChar(50)
  startDate     DateTime
  endDate       DateTime
  calories      Decimal  @default(0) @db.Decimal(8, 2)
  intensity     Int?
  steps         Int      @default(0)
  distance      Decimal  @default(0) @db.Decimal(10, 2)
  elevation     Decimal  @default(0) @db.Decimal(8, 2)
  hrAverage     Int?
  hrMin         Int?
  hrMax         Int?
  hrZone0       Int      @default(0)
  hrZone1       Int      @default(0)
  hrZone2       Int      @default(0)
  hrZone3       Int      @default(0)
  pauseDuration Int      @default(0)
  spo2Average   Decimal? @db.Decimal(4, 1)
  poolLaps      Int?
  poolLength    Int?
  strokes       Int?

  @@unique([userId, startDate])
  @@index([userId])
}

model WithingsSleep {
  id                            Int      @id @default(autoincrement())
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @default(now()) @updatedAt
  date                          DateTime
  user                          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                        Int
  startDate                     DateTime?
  endDate                       DateTime?
  lightSleepDuration            Int      @default(0)
  deepSleepDuration             Int      @default(0)
  remSleepDuration              Int      @default(0)
  wakeupDuration                Int      @default(0)
  wakeupCount                   Int      @default(0)
  durationToSleep               Int      @default(0)
  durationToWakeup              Int      @default(0)
  hrAverage                     Int?
  hrMin                         Int?
  hrMax                         Int?
  rrAverage                     Int?
  rrMin                         Int?
  rrMax                         Int?
  breathingDisturbancesIntensity Int?
  snoring                       Int?
  snoringEpisodeCount           Int?
  sleepScore                    Int?
  totalSleepTime                Int      @default(0)
  totalTimeInBed                Int      @default(0)
  sleepEfficiency               Decimal? @db.Decimal(5, 2)
  sleepLatency                  Int?
  waso                          Int?
  outOfBedCount                 Int?
  nbRemEpisodes                 Int?

  @@unique([userId, date])
  @@index([userId])
}

model Coach {
  id              Int            @id @default(autoincrement())
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          Int
  goal            goals          @default(ZERO)
  kindOfDiet      kindOfDiets    @default(REGULAR)
  isSportActive   Boolean        @default(false)
  activityLevel   activityLevels @default(AVERAGE)
  countedProteins Int            @default(0)
  countedCarbs    Int            @default(0)
  countedFats     Int            @default(0)
  countedCalories Int            @default(0)
  currentWeight   Decimal        @db.Decimal(4, 1)
  changeInWeight  Decimal        @db.Decimal(4, 1)
  isDataInJuicify Boolean        @default(false)
  data            Json

  @@index([userId])
}

model BurnedCalories {
  id             Int      @id @default(autoincrement())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  whenAdded      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int
  name           String   @db.VarChar(255)
  burnedCalories Int
  source         String?  @db.VarChar(20)

  @@unique([id, userId])
  @@index([userId])
}

model Post {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  whenAdded DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  title     String   @db.VarChar(255)
  content   String   @db.Text
  img_url   String

  @@unique([id, userId])
  @@index([userId])
}

model Article {
  slug        String   @id
  isPublished Boolean  @default(false)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  // English (required)
  titleEn     String
  excerptEn   String
  contentEn   String   @db.Text
  metaTitleEn String?
  metaDescEn  String?

  // Polish
  titlePl     String?
  excerptPl   String?
  contentPl   String?  @db.Text
  metaTitlePl String?
  metaDescPl  String?

  // Spanish
  titleEs     String?
  excerptEs   String?
  contentEs   String?  @db.Text
  metaTitleEs String?
  metaDescEs  String?

  // German
  titleDe     String?
  excerptDe   String?
  contentDe   String?  @db.Text
  metaTitleDe String?
  metaDescDe  String?

  // Portuguese
  titlePt     String?
  excerptPt   String?
  contentPt   String?  @db.Text
  metaTitlePt String?
  metaDescPt  String?

  // French
  titleFr     String?
  excerptFr   String?
  contentFr   String?  @db.Text
  metaTitleFr String?
  metaDescFr  String?

  // Korean
  titleKo     String?
  excerptKo   String?
  contentKo   String?  @db.Text
  metaTitleKo String?
  metaDescKo  String?

  // Arabic
  titleAr     String?
  excerptAr   String?
  contentAr   String?  @db.Text
  metaTitleAr String?
  metaDescAr  String?

  // Turkish
  titleTr     String?
  excerptTr   String?
  contentTr   String?  @db.Text
  metaTitleTr String?
  metaDescTr  String?

  // Japanese
  titleJa     String?
  excerptJa   String?
  contentJa   String?  @db.Text
  metaTitleJa String?
  metaDescJa  String?

  // Italian
  titleIt     String?
  excerptIt   String?
  contentIt   String?  @db.Text
  metaTitleIt String?
  metaDescIt  String?

  // Shared fields
  featuredImageUrl          String?
  featuredImageAlt          String?
  featuredImageOwnerName    String?
  featuredImageOwnerUsername String?
  readingTimeMinutes        Int      @default(1)
  faqs                      Json?
  niche                     String?
  references                Json?

  @@index([isPublished, publishedAt])
}
